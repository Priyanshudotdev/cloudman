# CloudMan production env template for `docker compose -f docker-compose.prod.yml up`.
# Copy to `.env.production` and fill in real values. This file is gitignored.
#
# IMPORTANT — how compose resolves these values:
# - `env_file: [.env.production]` injects every KEY=VALUE here into the
#   container environment.
# - `${VAR}` interpolation in docker-compose.prod.yml (e.g. CLOUDMAN_SECRET)
#   is resolved from YOUR SHELL environment or a `.env` file in the repo
#   root — NOT from `.env.production`. So either `export CLOUDMAN_SECRET=…`
#   before `docker compose up`, or create a root `.env` containing it.
#   `docker compose config` shows the resolved result; check it before up.
#
# Generate secrets:
#   CLOUDMAN_SECRET=$(openssl rand -hex 32)        # 64 hex chars, api+worker share it
#   BETTER_AUTH_SECRET=$(openssl rand -base64 32)  # min 32 chars

# ── Mongo / Redis (defaults in compose already point at the bundled services;
#     only override here if you use external hosts) ──────────────────────────
# DATABASE_URL=mongodb://mongodb:27017/cloudman
# REDIS_URL=redis://redis:6379

# ── Auth ───────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://your-web-domain
CORS_ORIGIN=https://your-web-domain

# ── Secrets at rest (REQUIRED in production — api/worker refuse to boot
#     without it; same value in both services) ─────────────────────────────
CLOUDMAN_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Web (public, baked into the Next.js build) ─────────────────────────────
NEXT_PUBLIC_API_URL=https://your-api-domain

# ── Worker / AWS ───────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Fallback identity when a deployment has no AwsConnection. Prefer leaving
# these unset and using per-connection AssumeRole instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# "1" = simulate tofu (safe default until AWS is wired); "0" = real deploys.
CLOUDMAN_WORKER_MOCK=1
# "1" (default) = per-project S3 state bucket; "0" = local workspace state.
CLOUDMAN_REMOTE_STATE=1

# ── Optional ───────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
# OPENROUTER_API_KEY=
# CLOUDMAN_LLM_GENERATION=1
# TOFU_PATH=/usr/local/bin/tofu
# CLOUDMAN_TOFU_AUTOINSTALL=0
# CLOUDMAN_WORKSPACE_ROOT=/var/cloudman/workspaces
# PORT=4000
