# CloudMan environment template.
# Copy the relevant blocks into each app's .env file (apps/web/.env, apps/api/.env, apps/worker/.env).
# Local infrastructure (MongoDB + Redis) is provided by `docker compose up -d`.

# ── Shared ────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/cloudman
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3001
# Dev-only: serve unauthenticated API requests as a shared workspace user
# instead of rejecting with 401. Convenient for local demos; NEVER enable in
# production (all visitors would share projects + stored AWS/SSH credentials).
# ALLOW_ANON=1

# ── Google OAuth (optional) ────────────────────────────────────────────────
# Set in BOTH apps/web/.env and apps/api/.env. Without these, the Google
# sign-in button is hidden and only email/password login is available.
#   Google callback URL: http://localhost:4000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# apps/web/.env only — set to "true" to show the Google sign-in button.
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# ── API ───────────────────────────────────────────────────────────────────
PORT=4000

# ── Optional LLM stack generation (OpenRouter) ─────────────────────────────
# Without these, Generate uses deterministic blueprint templates.
# OPENROUTER_API_KEY=
# CLOUDMAN_LLM_GENERATION=1

# ── Secrets at rest ───────────────────────────────────────────────────────
# 32-byte hex key used to encrypt AWS connection external ids in MongoDB.
# Generate: openssl rand -hex 32  (same value goes into api + worker .env)
# CLOUDMAN_SECRET=

# ── Worker / AWS ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Optional dev fallback when no AwsConnection record exists:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Store OpenTofu state in a per-project S3 bucket (default "1"; "0" = local workspace state)
# CLOUDMAN_REMOTE_STATE=1
# Worker execution mode (apps/worker/.env): "1" = simulate tofu without
# touching AWS (recommended for local dev); "0" = real deployments.
# CLOUDMAN_WORKER_MOCK=1
# Optional OpenTofu knobs (apps/worker/.env):
# TOFU_PATH=/usr/local/bin/tofu
# CLOUDMAN_TOFU_AUTOINSTALL=0
# CLOUDMAN_WORKSPACE_ROOT=/tmp/cloudman-workspaces
# Set to "1" to bypass env validation (used by the Docker web build and tests;
# never set in production — it also skips the CLOUDMAN_SECRET format check).
# SKIP_ENV_VALIDATION=
