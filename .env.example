# CloudMan environment template.
# Copy the relevant blocks into each app's .env file (apps/web/.env, apps/api/.env, apps/worker/.env).
# Local infrastructure (MongoDB + Redis) is provided by `docker compose up -d`.

# ── Shared ────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/cloudman
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3001

# ── API ───────────────────────────────────────────────────────────────────
PORT=4000

# ── Secrets at rest ───────────────────────────────────────────────────────
# 32-byte hex key used to encrypt AWS connection external ids in MongoDB.
# Generate: openssl rand -hex 32  (same value goes into api + worker .env)
# CLOUDMAN_SECRET=

# ── Worker / AWS ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Optional dev fallback when no AwsConnection record exists:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Store OpenTofu state in a per-project S3 bucket (default "1"; "0" = local workspace state)
# CLOUDMAN_REMOTE_STATE=1
